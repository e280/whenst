{
	"private": true,
	"name": "@e280/whenst",
	"version": "0.1.5",
	"description": "website to help people tell what time a thing is at",
	"license": "MIT",
	"main": "./x/index.js",
	"type": "module",
	"files": [
		"x",
		"s"
	],
	"dependencies": {
		"@e280/sly": "0.4.6",
		"@e280/strata": "0.4.4",
		"@e280/stz": "0.3.10",
		"lit": "^3.3.3",
		"micromark": "^4.0.2",
		"micromark-extension-gfm": "^3.0.0"
	},
	"devDependencies": {
		"@e280/hottie": "^0.1.5",
		"@e280/octo": "^0.1.5",
		"@e280/science": "^0.1.12",
		"@e280/scute": "^0.5.1",
		"typescript": "^7.0.2"
	},
	"scripts": {
		"build": "rm -rf x && mkdir x && tsc && scute -v",
		"dev": "octo 'tsc -w' 'node --watch x/tests.test.js' 'scute -wv' 'hottie x'",
		"test": "node x/tests.test.js",
		"count": "find s -path '*/_archive' -prune -o -name '*.ts' -exec wc -l {} +"
	},
	"author": "Chase Moskal <chasemoskal@gmail.com>",
	"homepage": "https://github.com/e280/when#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/e280/when.git"
	},
	"bugs": {
		"url": "https://github.com/e280/when/issues"
	},
	"keywords": [
		"when",
		"timezones",
		"local time"
	],
	"allowScripts": {
		"esbuild@0.28.2": true
	}
